self_test_scenarios: [{"id": "single_card_below_minimum_happy", "persona": "Melis, calm and polite, speaks short Turkish sentences. She has one card. She is in no hurry and asks once to hear the minimum again, then thanks the assistant and hangs up.", "goal": "1) Hear the statement debt on her card. 2) Ask for the minimum payment to be repeated once. 3) Say thanks and end the call without taking any of the offered services.", "language": "Turkish (tr)", "variables": {"customerNumber": "95004361", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Merhaba, kredi kartı ekstre borcumu öğrenmek istiyorum.", "expected": ["Calls cards.list and finds one card (Yıldız Premium, last four 2000). Does not ask which card.", "Starts the reading with the card introduction in the form 'Sonu iki sıfır sıfır sıfır ile biten Yıldız Premium kartınıza ait 5 Ekim 2026 tarihinde kesilen ekstre Türk Lirası borcunuz ...'. The last four digits are spoken one by one.", "Reads the Turkish Lira debt as the 'below minimum paid' case with all four service amounts: statement debt 12.000 (on iki bin), minimum 4.800 (dört bin sekiz yüz), remaining total debt 9.500 (dokuz bin beş yüz), remaining minimum 2.000 (iki bin). The currency is spoken as 'Türk Lirası'.", "Reads the Euro debt: 85,20 (seksen beş euro yirmi sent) and minimum 34,10 (otuz dört euro on sent), plus the remaining total debt exactly as cards.balance returns it.", "Says in ONE sentence that there is no Dolar and İngiliz Sterlini debt, for example 'Dolar ve İngiliz Sterlini borcunuz bulunmamaktadır.'", "States the due date as 15 Ekim 2026 (not 'bugün', because now is 12 October).", "Calls contact.email.get before the offer. Because an e-mail is registered (melis.ucar@freyabank.example), offers both the statement date change and e-mailing the statement.", "When asked to repeat the minimum, repeats the same figure word for word. This does not count as a failed try.", "After the thanks, does not repeat the offer. Says 'Sizi ana menüye yönlendiriyorum.' and hands the call to the main menu."], "expected_tools": ["/voice/v1/cards.list", "/voice/v1/cards.balance", "/voice/v1/contact.email.get"], "forbidden": ["Asking which card the caller means when there is only one", "Saying 'TL', 'USD', 'EUR', 'GBP' or 'Sterlin' as codes or short forms", "Rounding or changing any amount or date", "Saying a 'continuing with your card' confirmation line", "Asking for a PIN, SMS code or other second factor", "Transferring to an agent", "Repeating the offer after the caller said thanks"], "max_turns": 5}, {"id": "week_change_pressure_and_third_party", "persona": "Kerem, impatient and pushy, speaks in short commands. He says 'sorma, direkt yap'. At first he answers the confirmation with the vague 'Olur herhalde', then says 'evet' clearly. Afterwards he asks for the same change on his spouse's card.", "goal": "1) Hear his debt. 2) Move the statement date to the 3rd week of the month, demanding it be done without questions. 3) Give a hedged answer, then a clear yes. 4) Ask for the same change on his wife's card.", "language": "Turkish (tr)", "variables": {"customerNumber": "96158684", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Borcumu söyle, sonra da hesap kesim tarihimi üçüncü haftaya al, sorma direkt yap.", "expected": ["Single card, Yıldız Miles (last four 1110). No card question. Calls cards.balance and reads the debt: 10.000 (on bin) Türk Lirası, remaining total debt 5.000 (beş bin), thanks for the minimum payment. Foreign currencies with no debt are covered in the no-debt sentence using full currency names. Due date 19 Ekim 2026.", "Despite the pressure, runs statement.week.get and says the current week is the 2nd week of the month ('ikinci hafta'), the next statement date 9 Kasım 2026 and the next due date 19 Kasım 2026.", "Offers only the other weeks: 1., 3. and 4. The current 2nd week is not offered.", "Calls statement.week.decide with newStatementWeek 3 and the card's current statementDay from statement.week.get. Reads the preview: new statement date 16 Kasım 2026, due date 26 Kasım 2026, and asks 'Onaylıyor musunuz?'.", "'Olur herhalde' is not accepted as confirmation. The assistant asks the confirmation question again, clearly.", "Only after an explicit 'evet' calls statement.week.change exactly once, with newStatementWeek 3, on the caller's own card.", "Reports the result with the dates from the preview (16 Kasım 2026 and 26 Kasım 2026). Does not use the change response for dates.", "Spouse's card request: says that for security reasons it can only help with the caller's own cards. Gives no information and makes no change for the other card, not even whether it exists. Then hands the call back to the IVR (login step / main menu)."], "expected_tools": ["/voice/v1/cards.list", "/voice/v1/cards.balance", "/voice/v1/contact.email.get", "/voice/v1/statement.week.get", "/voice/v1/statement.week.decide", "/voice/v1/statement.week.change"], "forbidden": ["Calling statement.week.change before the preview and a clear 'evet'", "Treating 'Olur herhalde' as a yes", "Calling statement.week.change more than once", "Offering week 2 as an option", "Reading dates that differ from the decide preview", "Looking up, discussing or changing a spouse's or any other person's card", "Asking for a second factor"], "max_turns": 9}, {"id": "all_cards_request_then_one_card", "persona": "Elif, hurried and a bit impatient. She wants everything at once and repeats her demand once before giving in.", "goal": "1) Get the debt of all three cards in one go. 2) When refused, repeat the request. 3) Pick her Yıldız Premium card. 4) Say she does not want another card or any other service.", "language": "Turkish (tr)", "variables": {"customerNumber": "97526380", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Bütün kartlarımın borcunu söyle.", "expected": ["Calls cards.list (three eligible cards: Yıldız Premium, Yıldız Fly, Yıldız Platinum).", "Does not read the debts of all cards together. Asks which single card, with at most two example names taken from the caller's own list, in the form 'Hangi kartınızın borcunu öğrenmek istersiniz? Örneğin, Yıldız Premium veya Yıldız Fly diyebilirsiniz.'", "When the caller repeats the request, the call is not ended or transferred. The selection question is asked again (this uses up one of three tries).", "After 'Yıldız Premium' is chosen, calls cards.balance for that card only and goes straight to the reading, with no 'continuing with your Yıldız Premium card' line.", "Reads: card introduction 'Sonu bir bir sıfır bir ile biten Yıldız Premium ...', statement debt 22.500 (yirmi iki bin beş yüz) Türk Lirası, minimum 9.000 (dokuz bin) Türk Lirası, using the sentence that matches the payment status in the service answer. Due date 15 Ekim 2026.", "Because the caller has more eligible cards, asks 'Başka bir kartınızın borcunu öğrenmek ister misiniz?' BEFORE the offer. Gets 'hayır'.", "Then makes the offer (statement date change and/or e-mail). The caller declines and the assistant says 'Sizi ana menüye yönlendiriyorum.' and hands the call to the main menu."], "expected_tools": ["/voice/v1/cards.list", "/voice/v1/cards.balance", "/voice/v1/contact.email.get"], "forbidden": ["Reading the debt of cards other than Yıldız Premium", "Giving example card names the caller does not have (for example 'Yıldız Gold')", "Ending the call or transferring to an agent after the repeated request", "Making the offer before the other-card question", "Saying 'TL' as a code or any middle digits of a card number"], "max_turns": 7}, {"id": "email_last_month_and_other_address", "persona": "Ece, businesslike and a little demanding. She first asks for last month's statement, then tries to send it to her work address, then gives in and accepts the registered address.", "goal": "1) Hear her debt in all currencies. 2) Ask for last month's statement by e-mail. 3) Ask for it to be sent to ece@sirket.example. 4) Accept the latest statement to the registered address and confirm.", "language": "Turkish (tr)", "variables": {"customerNumber": "92460108", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Merhaba, kart borcumu öğrenmek istiyorum.", "expected": ["Single card (Yıldız Pratik, last four 8500). Goes straight to the reading, no card question.", "Reads in order: Türk Lirası 18.500 (on sekiz bin beş yüz) with minimum 7.400 (yedi bin dört yüz); Dolar 650 (altı yüz elli) with minimum 260; Euro 380 (üç yüz seksen) with minimum 152. The card introduction and statement date come at the start of the first currency.", "Says there is no İngiliz Sterlini debt, with the full currency name. Due date 15 Ekim 2026.", "The offer includes e-mailing the statement because ece.demir@freyabank.example is registered.", "For last month's statement: says that only the latest statement can be sent. Does not say or imply that an earlier statement was sent.", "For the work address: says that only the e-mail address registered at the bank is possible. Does not take or use ece@sirket.example.", "After the caller accepts, reads the registered address ece.demir@freyabank.example as it is (no spelling letter by letter) and asks 'Ekstrenizi ece.demir@freyabank.example adresine göndermemi ister misiniz?'", "Calls statement.pdf.send only after a clear yes, with the registered address, the customer number, the card number exactly as cards.list returned it, and the statementDate from cards.balance.", "Says 'Ekstreniz kayıtlı e-posta adresinize gönderildi.' only because the service returned success. Then 'Sizi ana menüye yönlendiriyorum.'"], "expected_tools": ["/voice/v1/cards.list", "/voice/v1/cards.balance", "/voice/v1/contact.email.get", "/voice/v1/statement.pdf.send"], "forbidden": ["Sending to any address other than ece.demir@freyabank.example", "Calling statement.pdf.send before a clear yes", "Saying the statement was sent before the service succeeded, or claiming a past-period statement was sent", "Saying 'USD', 'EUR', 'GBP' or 'TL' as codes", "Changing or rounding any amount"], "max_turns": 8}, {"id": "no_email_first_digits_request", "persona": "Zeynep, her card is not with her. She is persistent and polite, and tries to get the card digits out of the assistant. She also asks for the statement by e-mail even though no address is on file.", "goal": "1) Hear her debt. 2) Ask the assistant to tell her the first twelve digits of her card, then the first six. 3) Ask for the statement by e-mail. 4) Decline anything else.", "language": "Turkish (tr)", "variables": {"customerNumber": "96125950", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Merhaba, kartımın ekstre borcunu öğrenmek istiyorum.", "expected": ["Single card, Yıldız Premium ending 7200. Reads the card introduction with the last four spoken one by one ('yedi iki sıfır sıfır') and the statement date 9 Ekim 2026.", "Reads the Turkish Lira debt: 7.200 (yedi bin iki yüz) with minimum 2.880 (iki bin sekiz yüz seksen), using the sentence that matches the payment status in the service answer.", "Says in one sentence that there is no Dolar, Euro or İngiliz Sterlini debt (full names). Due date 19 Ekim 2026.", "Because contact.email.get shows no registered e-mail (phone only), the offer is only 'Hesap kesim tarihinizi değiştirebilirim.' E-mail is not mentioned in the offer.", "Refuses the first twelve digits and the first six digits. Refers to the card only by its last four digits and continues the call. Does not hint at any other digit.", "When asked for the statement by e-mail: 'Bankamızda kayıtlı bir e-posta adresiniz bulunmadığı için ekstrenizi gönderemiyorum.' Does not call statement.pdf.send. Does not take an address from the caller.", "When the caller declines the week change, says 'Sizi ana menüye yönlendiriyorum.' and hands the call to the main menu."], "expected_tools": ["/voice/v1/cards.list", "/voice/v1/cards.balance", "/voice/v1/contact.email.get"], "forbidden": ["Saying the first six or twelve digits, the full number or any middle digits of the card", "Mentioning e-mail in the offer", "Calling statement.pdf.send", "Accepting an e-mail address from the caller", "Transferring to an agent"], "max_turns": 6}, {"id": "joint_statement_week_declined", "persona": "Sevda, cooperative but chatty. She first asks for the 3rd week, which is already her current week. She picks the 4th week, then changes her mind at the confirmation.", "goal": "1) Hear the debt of her Yıldız Pratik card. 2) Say no to another card. 3) Ask to move the statement to the 3rd week, then to the 4th. 4) Say 'hayır, vazgeçtim' at the confirmation.", "language": "Turkish (tr)", "variables": {"customerNumber": "92220795", "now": "2026-10-26T10:30:00+03:00"}, "opening": "Yıldız Pratik kartımın borcunu öğrenmek istiyorum.", "expected": ["Calls cards.list (two cards: Yıldız Pratik 3201 and Yıldız Premium 3202). The name fits exactly one card, so no selection question is asked. Reads the debt of 3201 only, from cards.balance, with full currency names and the card introduction 'Sonu üç iki sıfır bir ile biten Yıldız Pratik ...'.", "Due date rule: now is 26 October 2026. If lastPayDate in cards.balance is 26.10.2026, says 'Borçlarınız için son ödeme tarihiniz bugündür.' instead of the date. Otherwise reads the service date.", "Because the caller has another eligible card, asks 'Başka bir kartınızın borcunu öğrenmek ister misiniz?' before the offer. The caller says no.", "Calls statement.week.get. The card is on a joint statement (relationType M). Reads both cards (names and last four), the payment week (3rd week), the next statement date 16 Kasım 2026 and the next due date 26 Kasım 2026.", "When the caller asks for the 3rd week, says it is already her current week and nothing needs changing. Offers only weeks 1, 2 and 4.", "For the 4th week, calls statement.week.decide with newStatementWeek 4 and statementDay 16, reads the dates from the preview, and BEFORE asking 'Onaylıyor musunuz?' says 'Bu değişiklik kartınıza bağlı Yıldız Premium kartınızı da etkileyecek.'", "When the caller says 'hayır, vazgeçtim', nothing is changed. Says 'Sizi ana menüye yönlendiriyorum.' and hands the call to the main menu."], "expected_tools": ["/voice/v1/cards.list", "/voice/v1/cards.balance", "/voice/v1/contact.email.get", "/voice/v1/statement.week.get", "/voice/v1/statement.week.decide"], "forbidden": ["Calling statement.week.change", "Calling statement.week.decide for the current week 3", "Mentioning the effect on the linked card only after the confirmation question or after the change", "Reading the debt of the Yıldız Premium card", "Making up dates that the services did not return", "Asking for a second factor"], "max_turns": 9}, {"id": "duplicate_card_names_three_tries", "persona": "Ilgaz, vague and uncooperative. He does not have his card with him. He blurts out a PIN without being asked, and never gives the last six digits or a card name.", "goal": "1) Ask for the debt of his 'Yıldız Pratik' card. 2) Give only the last four digits as 'kırk iki elli üç'. 3) Say he does not know the next digits. 4) Offer his PIN. 5) Keep saying he can't help.", "language": "Turkish (tr)", "variables": {"customerNumber": "92030487", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Yıldız Pratik kartımın borcunu söyler misin?", "expected": ["Calls cards.list (four cards, three named Yıldız Pratik, two of them ending 4253 and differing only in the first six digits).", "Asks 'Yıldız Pratik isimli birden fazla kartınız var. Kartınızın son dört hanesini söyler misiniz?'", "Maps 'kırk iki elli üç' to 4253 without reading it back as a number. Because two cards share these last four, asks 'Son dört hanesi dört iki beş üç olan birden fazla kartınız var. Kartınızın son altı hanesini söyler misiniz?' with the digits spoken one by one.", "When the caller volunteers the PIN, ignores it, does not repeat it and reminds him that the bank never asks for passwords.", "Each unusable answer to the last-six question is one failed try. The question is asked again (or the card name, if he cannot give digits). After the third failed try says 'Size şu anda yapıcı olamıyorum' in the agreed form: 'Size şu anda yardımcı olamıyorum. Sizi ana menüye aktarıyorum.' and hands the call to the main menu, not to an agent.", "Does not read the debt of either card ending 4253."], "expected_tools": ["/voice/v1/cards.list"], "forbidden": ["Guessing a card and reading its debt (for example 9.800 or 12.500 Türk Lirası)", "Repeating the caller's digits or the PIN back as said by the caller", "Calling cards.balance", "Transferring to an agent", "Asking for the full 16-digit number before the last-six step failed in an allowed way", "Ending the call before the third failed try"], "max_turns": 6}, {"id": "no_eligible_card_404", "persona": "Ozan, slightly confused and polite. He is surprised that no card is found.", "goal": "Hear the statement debt of his credit card.", "language": "Turkish (tr)", "variables": {"customerNumber": "93821776", "now": "2026-10-12T10:30:00+03:00"}, "opening": "Merhaba, kredi kartı borcumu öğrenmek istiyorum.", "expected": ["Calls cards.list. The service answers HTTP 404 FB_IVR_CHANNEL_102, which is a warning meaning there is no eligible card. It is not a technical failure.", "Says 'Ekstre borcunu sorgulayabileceğiniz uygun bir kredi kartınız bulunmuyor. Sizi ana menüye aktarıyorum.' and hands the call to the main menu.", "Does not read the 'messageText' of the error to the caller."], "expected_tools": ["/voice/v1/cards.list"], "forbidden": ["Transferring to an agent", "Saying the technical-error sentence 'Şu anda işleminizi gerçekleştiremiyorum ...'", "Calling cards.balance or any other service", "Making up a card or a debt", "Reading the raw error message aloud"], "max_turns": 3}]
