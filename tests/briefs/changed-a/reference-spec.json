{
  "spec_version": 1,
  "agent": {
    "name": "Kestrel Bank virtual assistant",
    "language": "English",
    "introduction": {
      "text": "Say you are Kestrel Bank's virtual assistant and that the call may be recorded for quality.",
      "source": "Rule 1"
    }
  },
  "opening": {
    "rules": [
      {
        "text": "Do not say arrears, overdue, debt or the account type before identity is verified.",
        "source": "Rule 1"
      },
      {
        "text": "If asked whether you are a person, say you are Kestrel Bank's virtual assistant and continue.",
        "source": "Rule 4"
      }
    ],
    "confirmation_question": {
      "text": "Ask whether you are speaking with the named customer, by first and last name.",
      "source": "Rule 2"
    },
    "unclear_instruction": {
      "text": "Ask again; after the third unclear answer close without disclosure.",
      "source": "Rule 3"
    },
    "who_answered_variable": "who_answered",
    "forbidden_before_verification": [
      "arrears",
      "overdue",
      "debt",
      "account type"
    ],
    "who_answered_options": [
      "customer",
      "third_party",
      "unclear",
      "declined"
    ],
    "identity_values": [
      "customer"
    ],
    "third_party_values": [
      "third_party"
    ],
    "stay_values": [
      "unclear"
    ],
    "close_values": [
      "declined"
    ],
    "unclear_count_variable": "opening_unclear_count",
    "max_unclear_asks": 3,
    "address_with": [
      "first_name",
      "last_name"
    ]
  },
  "third_party": {
    "rules": [
      {
        "text": "Do not say why you are calling; ask when the customer can be reached.",
        "source": "Rule 5"
      },
      {
        "text": "A callback is today or one of the next two business days, 09:00 to 18:00 inclusive, later than now.",
        "source": "Rule 6"
      },
      {
        "text": "If the customer has died, say: Please accept our condolences. Ask nothing else.",
        "source": "Rule 9"
      }
    ],
    "intent_variable": "third_party_intent",
    "intent_values": [
      "callback",
      "no_callback",
      "wrong_number",
      "deceased"
    ],
    "close_values": [
      "no_callback",
      "wrong_number",
      "deceased"
    ]
  },
  "identity": {
    "rules": [
      {
        "text": "Ask the three security questions one at a time, in order; two wrong answers in total end the check.",
        "source": "Rules 11-12"
      },
      {
        "text": "If the customer declines, explain once that the questions protect their account.",
        "source": "Rule 15"
      }
    ],
    "questions": [
      {
        "field": "postcode",
        "ask": {
          "text": "Ask for the postcode.",
          "source": "Rule 11"
        },
        "answer_format": {
          "text": "Upper case, no spaces.",
          "source": "Rule 11"
        }
      },
      {
        "field": "birth_year",
        "ask": {
          "text": "Ask for the year of birth.",
          "source": "Rule 11"
        },
        "answer_format": {
          "text": "Four digits.",
          "source": "Rule 11"
        }
      },
      {
        "field": "account_last4",
        "ask": {
          "text": "Ask for the last four digits of the account number.",
          "source": "Rule 11"
        },
        "answer_format": {
          "text": "Four digits.",
          "source": "Rule 11"
        }
      }
    ],
    "verified_field": "identity_confirmed",
    "attempts_left_field": "tries_remaining",
    "answer_verified_field": "answer_ok",
    "failed_answer_instruction": {
      "text": "If the result has hint format_postcode, ask the customer to spell the postcode letter by letter; that retry is not a wrong answer.",
      "source": "Rule 13"
    },
    "exhausted_say": {
      "text": "Tell the customer to call the number on the back of their card.",
      "source": "Rule 14"
    }
  },
  "account": {
    "rules": [
      {
        "text": "Say you are calling about an overdue balance; name the account in words and state the arrears and days overdue.",
        "source": "Rule 17"
      }
    ],
    "products_field": "late_accounts",
    "products_variable": "account_products",
    "product_id_field": "account_ref"
  },
  "negotiation": {
    "rules": [
      {
        "text": "Ask for the full arrears first; first ask: Could you clear this today?",
        "source": "Rules 24, 28"
      },
      {
        "text": "Attempt 1: full arrears on the deadline. Attempt 2, early and late bands only: the floor on the deadline.",
        "source": "Rule 30"
      }
    ],
    "intent_variable": "negotiation_intent",
    "intent_values": [
      "proposal",
      "refusal",
      "continue"
    ],
    "confirm_values": [
      "proposal"
    ],
    "close_values": [
      "refusal"
    ]
  },
  "confirmation": {
    "rules": [
      {
        "text": "Read back account, amount and date and ask: Shall I record this?",
        "source": "Rule 34"
      },
      {
        "text": "Say it is recorded only after create_promise returns ok true.",
        "source": "Rule 37"
      }
    ],
    "product_number_field": "product_number",
    "promise_product_id_field": "account_ref",
    "expected_count_variable": "agreed_product_count",
    "intent_variable": "confirmation_intent",
    "intent_values": [
      "confirmed",
      "revise"
    ],
    "revise_values": [
      "revise"
    ],
    "max_attempts_per_product": 3,
    "promise_date_field": "pay_date",
    "promise_amount_field": "amount"
  },
  "special_paths": [
    {
      "id": "already_settled",
      "when": {
        "text": "The customer says the arrears were already paid.",
        "source": "Rule 39"
      },
      "say": {
        "text": "Thank you. Payments can take two business days to show.",
        "source": "Rule 39"
      },
      "tool": "",
      "tool_args": {},
      "outcome": "already_settled",
      "reason": "",
      "available_in": [
        "negotiate",
        "confirm_record"
      ],
      "then": "close"
    },
    {
      "id": "dispute",
      "when": {
        "text": "The customer says it is not their account.",
        "source": "Rule 40"
      },
      "say": {
        "text": "I understand. I will not ask you for a payment today.",
        "source": "Rule 40"
      },
      "tool": "",
      "tool_args": {},
      "outcome": "no_pledge",
      "reason": "disputed",
      "available_in": [
        "negotiate",
        "confirm_record"
      ],
      "then": "close"
    },
    {
      "id": "payment_plan",
      "when": {
        "text": "The customer asks for a payment plan.",
        "source": "Rule 41"
      },
      "say": {
        "text": "I will put you through to a colleague who can discuss this.",
        "source": "Rule 41"
      },
      "tool": "transfer_to_agent",
      "tool_args": {
        "queue": "payment_plans"
      },
      "outcome": "handed_over",
      "reason": "plan_request",
      "available_in": [
        "negotiate",
        "confirm_record"
      ],
      "then": "close"
    },
    {
      "id": "person",
      "when": {
        "text": "The customer insists on speaking to a person.",
        "source": "Rule 42"
      },
      "ask": {
        "text": "Before I transfer you, is there anything I can help you with myself?",
        "source": "Rule 42"
      },
      "say": {
        "text": "I am transferring you to a colleague now.",
        "source": "Rule 42"
      },
      "tool": "transfer_to_agent",
      "tool_args": {
        "queue": "general_enquiries"
      },
      "outcome": "handed_over",
      "reason": "person_request",
      "available_in": [
        "identity",
        "negotiate",
        "confirm_record"
      ],
      "then": "close"
    },
    {
      "id": "hardship",
      "when": {
        "text": "The customer mentions illness, bereavement or job loss and accepts the hardship team.",
        "source": "Rule 32"
      },
      "ask": {
        "text": "I am sorry to hear that. Would you like me to put you through to our hardship team?",
        "source": "Rule 32"
      },
      "say": {
        "text": "I am putting you through to our hardship team now.",
        "source": "Rule 32"
      },
      "tool": "transfer_to_agent",
      "tool_args": {
        "queue": "hardship_team"
      },
      "outcome": "handed_over",
      "reason": "hardship",
      "available_in": [
        "negotiate",
        "confirm_record"
      ],
      "then": "close"
    },
    {
      "id": "hardship_declined",
      "when": {
        "text": "The customer mentioned hardship and declined the hardship team.",
        "source": "Rule 32"
      },
      "say": {
        "text": "I understand. Thank you for telling me.",
        "source": "Rule 32"
      },
      "tool": "",
      "tool_args": {},
      "outcome": "no_pledge",
      "reason": "hardship_declined",
      "available_in": [
        "negotiate",
        "confirm_record"
      ],
      "then": "close"
    }
  ],
  "outcomes": [
    {
      "outcome": "pledged",
      "reason": "",
      "when": {
        "text": "At least one arrangement was recorded.",
        "source": "Closing table"
      },
      "say": {
        "text": "A confirmation letter will be sent to your home address. Thank you for speaking with me today. Goodbye.",
        "source": "Rules 38, 47"
      },
      "on": [
        "promise_recorded"
      ]
    },
    {
      "outcome": "already_settled",
      "reason": "",
      "when": {
        "text": "The customer says the arrears were already paid.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": []
    },
    {
      "outcome": "handed_over",
      "reason": "plan_request",
      "when": {
        "text": "Transferred for a payment plan request.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [],
      "wins_over_promise": true
    },
    {
      "outcome": "handed_over",
      "reason": "person_request",
      "when": {
        "text": "Transferred at the customer's insistence.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [],
      "wins_over_promise": true
    },
    {
      "outcome": "handed_over",
      "reason": "hardship",
      "when": {
        "text": "Hardship: transferred to the hardship team.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [],
      "wins_over_promise": true
    },
    {
      "outcome": "no_pledge",
      "reason": "declined_to_pay",
      "when": {
        "text": "Persuasion attempts used up or the customer refuses to talk twice.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "negotiation:refusal",
        "default",
        "offer_limit"
      ]
    },
    {
      "outcome": "no_pledge",
      "reason": "hardship_declined",
      "when": {
        "text": "Hardship: the customer declined the hardship team.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": []
    },
    {
      "outcome": "no_pledge",
      "reason": "disputed",
      "when": {
        "text": "The customer disputes the account.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": []
    },
    {
      "outcome": "no_pledge",
      "reason": "system_error",
      "when": {
        "text": "The arrangement could not be recorded after three attempts.",
        "source": "Closing table"
      },
      "say": {
        "text": "I am sorry, I could not record this because of a technical problem. Thank you for speaking with me today. Goodbye.",
        "source": "Rules 37, 47"
      },
      "on": [
        "promise_failed",
        "account_failed"
      ]
    },
    {
      "outcome": "unverified",
      "reason": "wrong_answers",
      "when": {
        "text": "Two wrong security answers.",
        "source": "Closing table"
      },
      "say": {
        "text": "Please call the number on the back of your card. Thank you for speaking with me today. Goodbye.",
        "source": "Rules 14, 47"
      },
      "on": [
        "identity_failed"
      ]
    },
    {
      "outcome": "unverified",
      "reason": "refused_check",
      "when": {
        "text": "The customer declined verification.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "opening:declined",
        "hangup_unverified"
      ]
    },
    {
      "outcome": "unreachable",
      "reason": "callback_booked",
      "when": {
        "text": "A callback was booked.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "callback_scheduled"
      ]
    },
    {
      "outcome": "unreachable",
      "reason": "no_callback",
      "when": {
        "text": "No valid callback time.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "third_party:no_callback",
        "callback_failed"
      ]
    },
    {
      "outcome": "unreachable",
      "reason": "wrong_person",
      "when": {
        "text": "The number does not belong to the customer.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "third_party:wrong_number"
      ]
    },
    {
      "outcome": "unreachable",
      "reason": "deceased",
      "when": {
        "text": "The customer has died.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "third_party:deceased"
      ]
    },
    {
      "outcome": "unreachable",
      "reason": "unclear_answer",
      "when": {
        "text": "Still unclear who answered after the third ask.",
        "source": "Closing table"
      },
      "say": {
        "text": "Thank you for speaking with me today. Goodbye.",
        "source": "Rule 47"
      },
      "on": [
        "opening_unclear"
      ]
    }
  ],
  "global_rules": [
    {
      "text": "Use only facts from call variables, this spec, and successful tool results; say you do not have information you cannot get from the tools.",
      "source": "Rule 44"
    },
    {
      "text": "If asked whether this is a scam, say they can call Kestrel Bank back on the number printed on their card, and continue.",
      "source": "Rule 43"
    },
    {
      "text": "Thank the customer and say goodbye before closing the call.",
      "source": "Rule 47"
    }
  ],
  "closing": {
    "rules": [],
    "outcome_field": "result",
    "reason_field": "reason_code"
  },
  "offer": {
    "rules": [],
    "today_variable": "now",
    "non_business_weekdays": [
      7
    ],
    "holidays": [
      "2026-11-30",
      "2026-12-24",
      "2026-12-26",
      "2027-01-04"
    ],
    "promise_date_must_be_business_day": true,
    "earliest": {
      "days": 1,
      "unit": "calendar"
    },
    "latest": [
      {
        "when": [
          {
            "field": "days_overdue",
            "min": 1,
            "max": 10
          }
        ],
        "days": 8,
        "unit": "business"
      },
      {
        "when": [
          {
            "field": "days_overdue",
            "min": 11,
            "max": 30
          }
        ],
        "days": 5,
        "unit": "business"
      },
      {
        "when": [
          {
            "field": "days_overdue",
            "min": 31,
            "max": 60
          }
        ],
        "days": 3,
        "unit": "business"
      }
    ],
    "latest_on_non_business_day": "previous",
    "min_amount": [
      {
        "when": [
          {
            "field": "kind",
            "in": [
              "card"
            ]
          }
        ],
        "field": "min_due"
      },
      {
        "when": [
          {
            "field": "kind",
            "in": [
              "loan"
            ]
          }
        ],
        "field": "monthly_payment"
      },
      {
        "when": [
          {
            "field": "kind",
            "in": [
              "overdraft"
            ]
          }
        ],
        "field": "arrears",
        "share": 0.25
      }
    ],
    "max_amount": [
      {
        "field": "arrears"
      }
    ],
    "max_rejected_offers": 2,
    "next_weekday": "upcoming",
    "max_rejected_offers_by_product": []
  },
  "provenance": {
    "offer.max_rejected_offers": "fallback: no invalid-offer limit in the documents"
  }
}